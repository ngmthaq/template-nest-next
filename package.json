{
  "name": "nestjs-template",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "backend": "pnpm --filter @nestjs-template/backend",
    "backend:dev": "pnpm --filter @nestjs-template/backend start:dev",
    "backend:build": "pnpm --filter @nestjs-template/backend build",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "lint:check": "pnpm -r lint:check",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check",
    "test": "pnpm -r test"
  }
}
