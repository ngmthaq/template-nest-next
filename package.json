{
  "name": "template-nest-next",
  "version": "0.0.36",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12.6.0"
  },
  "scripts": {
    "prepare": "husky",
    "server": "pnpm --filter @template-nest-next/server",
    "client": "pnpm --filter @template-nest-next/client",
    "py-service": "pnpm --filter @template-nest-next/py-service",
    "infra": "bash scripts/01_run_docker_infra.sh",
    "deploy:vm": "bash scripts/02_deploy_docker_vm.sh",
    "version:major": "pnpm version major --no-git-tag-version",
    "version:minor": "pnpm version minor --no-git-tag-version",
    "version:patch": "pnpm version patch --no-git-tag-version"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0"
  }
}
