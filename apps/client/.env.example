# Copy to .env.<APP_ENV>. The start scripts set APP_ENV, which picks the file to load; every
# .env* but this one is git-ignored. See "Getting started" in README.md for the load order.

# Port the Next.js server listens on. Read by load-env-cli.mjs before Next boots, so no -p flag.
PORT=3001

# Base URL of apps/server, including its /api prefix. Resolved server-side, so under compose use
# the internal hostname (http://server:3000/api) — localhost won't reach the server from there.
API_URL=http://localhost:3000/api

# Minimum log level (error, warn, info, debug) for logUtils. Server-side only — the browser has
# no runtime env vars, so client-side code always logs at `error`.
LOG_LEVEL=debug
