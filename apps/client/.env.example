# Example environment file — holds per-environment variables (NOT the environment
# name itself). `APP_ENV` is set by the npm start scripts (see package.json), which
# in turn selects which `.env.<APP_ENV>` file below gets loaded.
#
#   pnpm start:dev     -> APP_ENV=development -> .env.development
#   pnpm start:staging -> APP_ENV=staging     -> .env.staging
#   pnpm start:prod    -> APP_ENV=production  -> .env.production
#
# Load order per environment (first match wins), see next.config.ts:
#   1. .env.<APP_ENV>.local   (git-ignored, secrets/overrides)
#   2. .env.<APP_ENV>         (committed, shared per-environment defaults)
#   3. .env                   (git-ignored, local fallback)
#
# Variables prefixed with NEXT_PUBLIC_ are inlined into the browser bundle at
# build time; everything else stays server-side only.

# Port the Next.js server listens on (dev and start). Loaded before Next boots
# by the load-env-cli.mjs launcher, so no -p flag is needed in the scripts.
PORT=3001

# Base URL of the server API (apps/server), including its global /api prefix.
NEXT_PUBLIC_API_URL=http://localhost:3000/api
