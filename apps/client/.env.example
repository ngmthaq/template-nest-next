# Copy to .env.<APP_ENV>. The start scripts set APP_ENV, which picks the file to load; every
# .env* but this one is git-ignored. See "Getting started" in README.md for the load order.

# Port the Next.js server listens on. Read by load-env-cli.mjs before Next boots, so no -p flag.
PORT=3001

# Base URL of apps/server. Resolved server-side, so under compose use the internal hostname
# (http://server:3000) — localhost won't reach the server from there.
API_URL=http://localhost:3000

# Minimum log level (error, warn, info, debug) for logUtils. Server-side only — the browser has
# no runtime env vars, so client-side code always logs at `error`.
LOG_LEVEL=debug

# Base URL of the OpenObserve ingest API. Leave empty to turn off log shipping (console logging
# still works). Read on the server only. From inside Docker use the host, not localhost — see
# the server's README.md for the Docker note.
OPENOBSERVE_URL=

# OpenObserve organization to ship logs to
OPENOBSERVE_ORG=default

# OpenObserve stream to ship this app's logs to
OPENOBSERVE_STREAM=client

# OpenObserve login used to authenticate log ingest requests (basic auth)
OPENOBSERVE_USER=admin@example.com

# OpenObserve login password used to authenticate log ingest requests (basic auth)
OPENOBSERVE_PASSWORD=
