{
  "name": "@template-nest-next/client",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "next build",
    "start:dev": "cross-env APP_ENV=development node load-env-cli.mjs next dev",
    "start:debug": "cross-env APP_ENV=development INSPECT=1 node load-env-cli.mjs next dev",
    "start:staging": "cross-env APP_ENV=staging node load-env-cli.mjs next start",
    "start:prod": "cross-env APP_ENV=production node load-env-cli.mjs next start",
    "lint": "eslint --fix",
    "lint:check": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "shadcn-ui:add": "pnpm dlx shadcn@latest add",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:ui": "vitest run --ui"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@tanstack/react-table": "^9.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookies-next": "^6.1.1",
    "date-fns": "^4.4.0",
    "formik": "^2.4.9",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "next-intl": "^4.13.5",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.26",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.9",
    "@storybook/addon-docs": "^10.5.9",
    "@storybook/addon-themes": "^10.5.9",
    "@storybook/nextjs-vite": "^10.5.9",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "3.2.7",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-storybook": "^10.5.9",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.17.0",
    "storybook": "^10.5.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.25.0"
