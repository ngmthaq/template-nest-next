# Copy to .env.<APP_ENV>. The start scripts set APP_ENV, which picks the file to load; every
# .env* but this one is git-ignored. See "Environment" in README.md for the details.

# HTTP server bind address. Use 0.0.0.0 in Docker/production so the server accepts
# connections from outside the container.
HOST=127.0.0.1

# HTTP server port
PORT=8000

# Python logging level for the root logger (and, through it, uvicorn's own loggers)
LOG_LEVEL=INFO

# Base URL of the OpenObserve ingest API. This is the local default for a host run; clear it
# to turn off log shipping (console logging still works). From inside Docker use the host, not
# localhost — see README.md.
OPENOBSERVE_URL=http://localhost:5080

# OpenObserve organization to ship logs to
OPENOBSERVE_ORG=default

# OpenObserve stream to ship this app's logs to
OPENOBSERVE_STREAM=py-service

# OpenObserve login used to authenticate log ingest requests (basic auth)
OPENOBSERVE_USER=admin@example.com

# OpenObserve login password used to authenticate log ingest requests (basic auth). Matches
# ZO_ROOT_USER_PASSWORD for local OpenObserve — change this before any real deployment.
OPENOBSERVE_PASSWORD=ChangeMe123!
