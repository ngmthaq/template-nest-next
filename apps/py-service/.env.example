# Copy to .env.<APP_ENV>. Settings pick the file to load from APP_ENV (default "development");
# every .env* but this one is git-ignored.

# Selects which .env.<APP_ENV> file Settings loads (development, staging, production)
APP_ENV=development

# HTTP server bind address. Use 0.0.0.0 in Docker/production so the server accepts
# connections from outside the container.
HOST=127.0.0.1

# HTTP server port
PORT=8000
