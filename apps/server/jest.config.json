{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": "src/.*\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "collectCoverageFrom": [
    "src/**/*.(t|j)s",
    "!src/**/*.spec.ts",
    "!src/generated/**",
    "!src/shared/config/**"
  ],
  "coverageDirectory": "coverage",
  "testEnvironment": "node",
  "passWithNoTests": true
}
