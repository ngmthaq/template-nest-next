// Datasource and generator only. Models live one-per-file in sibling `*.prisma` files;
// the connection URL lives in `prisma.config.ts`, not here (Prisma 7).

generator client {
  provider     = "prisma-client"
  output       = "../../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}
