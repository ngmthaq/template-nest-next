# Example environment file — holds per-environment variables (NOT the environment
# name itself). `NODE_ENV` is set by the npm start script (see package.json), which
# in turn selects which `.env.<NODE_ENV>` file below gets loaded.
#
#   pnpm start         -> NODE_ENV=development -> .env.development
#   pnpm start:staging -> NODE_ENV=staging     -> .env.staging
#   pnpm start:prod    -> NODE_ENV=production  -> .env.production
#
# Load order per environment (first match wins), see src/core/core.module.ts:
#   1. .env.<NODE_ENV>.local   (git-ignored, secrets/overrides)
#   2. .env.<NODE_ENV>         (committed, shared per-environment defaults)
#   3. .env                    (git-ignored, local fallback)
#
# To add a new environment (e.g. staging): add a `start:staging` script with
# NODE_ENV=staging and create a matching `.env.staging` file.

# HTTP server port
PORT=3000

# Minimum log level emitted by the Winston logger.
# One of: error, warn, info, http, verbose, debug, silly (increasing verbosity)
LOG_LEVEL=debug

# In-memory cache: default time-to-live for entries, in milliseconds
CACHE_TTL=3600000

# In-memory cache: desired maximum number of entries (documented for
# forward-compatibility; not enforced by the default cache-manager v7 store)
CACHE_MAX=100
