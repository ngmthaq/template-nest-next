# Example environment file — holds per-environment variables (NOT the environment
# name itself). `NODE_ENV` is set by the npm start script (see package.json), which
# in turn selects which `.env.<NODE_ENV>` file below gets loaded.
#
#   pnpm start         -> NODE_ENV=development -> .env.development
#   pnpm start:staging -> NODE_ENV=staging     -> .env.staging
#   pnpm start:prod    -> NODE_ENV=production  -> .env.production
#
# Load order per environment (first match wins), see src/core/core.module.ts:
#   1. .env.<NODE_ENV>.local   (git-ignored, secrets/overrides)
#   2. .env.<NODE_ENV>         (committed, shared per-environment defaults)
#   3. .env                    (git-ignored, local fallback)
#
# To add a new environment (e.g. staging): add a `start:staging` script with
# NODE_ENV=staging and create a matching `.env.staging` file.

# HTTP server port
PORT=3000

# Minimum log level emitted by the Winston logger.
# One of: error, warn, info, http, verbose, debug, silly (increasing verbosity)
LOG_LEVEL=debug

# In-memory cache: default time-to-live for entries, in milliseconds
CACHE_TTL=3600000

# In-memory cache: desired maximum number of entries (documented for
# forward-compatibility; not enforced by the default cache-manager v7 store)
CACHE_MAX=100

# Outbound HTTP (HttpService/axios): request timeout in milliseconds
HTTP_TIMEOUT=60000

# Outbound HTTP (HttpService/axios): max redirects to follow before failing
HTTP_MAX_REDIRECTS=5

# CORS (applies to both the REST API and the WebSocket/Socket.IO server).
# Allowed origins: `*` reflects any origin, or a comma-separated allow-list
# (e.g. https://app.example.com,https://admin.example.com). Restrict this in
# production.
CORS_ORIGIN=*

# Allowed HTTP methods (comma-separated)
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE,OPTIONS

# Allowed request headers (comma-separated). Leave empty to reflect the
# browser's requested headers.
CORS_ALLOWED_HEADERS=

# Allow cookies / Authorization headers on cross-origin requests (true/false).
# Cannot be combined with a literal `*` origin — set explicit origins above.
CORS_CREDENTIALS=false

# Preflight cache duration in seconds. Leave empty for the browser default.
CORS_MAX_AGE=

# Rate limiting - short tier (burst protection): time window in milliseconds
THROTTLE_SHORT_TTL=1000

# Rate limiting - short tier: max requests allowed per client within the window
THROTTLE_SHORT_LIMIT=3

# Rate limiting - medium tier (mid-range window): time window in milliseconds
THROTTLE_MEDIUM_TTL=10000

# Rate limiting - medium tier: max requests allowed per client within the window
THROTTLE_MEDIUM_LIMIT=20

# Rate limiting - long tier (sustained cap): time window in milliseconds
THROTTLE_LONG_TTL=60000

# Rate limiting - long tier: max requests allowed per client within the window
THROTTLE_LONG_LIMIT=100

# Secret used to sign cookies (enables `request.signedCookies`). Leave empty
# for plain, unsigned cookie parsing.
COOKIE_SECRET=

# Response compression: minimum response size in bytes before compressing
COMPRESSION_THRESHOLD=1024

# Response compression: zlib level, 0 (none) to 9 (max), or -1 for the default
COMPRESSION_LEVEL=-1

# Hashing (HashService/bcrypt): cost factor for password hashing (2^rounds).
# Higher is more secure but slower; 10-12 is a common range.
HASH_SALT_ROUNDS=10

# Encryption (EncryptionService/AES-256-GCM): secret the key is derived from.
# Required only if you use EncryptionService. Use a long, random value.
ENCRYPTION_KEY=secret-random-encryption-key

# Encryption: salt for key derivation. Change from the default per deployment.
ENCRYPTION_SALT=salt

# Redis host
REDIS_HOST=localhost

# Redis port
REDIS_PORT=6379

# Redis password (leave empty if none)
REDIS_PASSWORD=
