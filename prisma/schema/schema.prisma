// Prisma datasource + generator configuration.
//
// Models live in sibling `*.prisma` files within this `prisma/schema/` folder
// (multi-file schema); one model per file. In Prisma 7 the connection URL lives
// in `prisma.config.ts` (which loads the project's `.env.<NODE_ENV>` files),
// not here.

generator client {
  provider     = "prisma-client"
  output       = "../../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}
